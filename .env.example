# DNS suffix for routes exposed by Traefik.
# These names must resolve to LAN_BIND_IP in your local DNS.
SERVER_NAME=home.example

# Host-local bind-mount root. Use an absolute path.
DATA_ROOT=/srv/infra/data

# LAN address of this Docker host. No 0.0.0.0 fallback is used intentionally.
# Published on this address: 80, 443, 2222, 4222, 5432, 9000, 9092.
LAN_BIND_IP=192.168.1.10

# Traefik / step-ca
STEP_CA_HOST=ca.home.example
STEP_CA_EMAIL=infra@home.example
STEP_CA_CERT_DURATION_HOURS=24

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app

# SSO and GitLab
KEYCLOAK_REALM=homelab
GITLAB_SSH_PORT=2222

# Resource limits
TRAEFIK_MEMORY_LIMIT=512m
POSTGRES_MEMORY_LIMIT=2g
CLICKHOUSE_MEMORY_LIMIT=4g
REDIS_NODE_MEMORY_LIMIT=768m
REDIS_MAXMEMORY=512mb
KAFKA_MEMORY_LIMIT=2g
NATS_MEMORY_LIMIT=256m
VAULT_MEMORY_LIMIT=1g
KEYCLOAK_MEMORY_LIMIT=1g
OAUTH2_PROXY_MEMORY_LIMIT=256m
HARBOR_MEMORY_LIMIT=1g
HARBOR_TRIVY_MEMORY_LIMIT=2g
GITLAB_MEMORY_LIMIT=8g
REDIS_STANDALONE_MEMORY_LIMIT=1536m
REDIS_STANDALONE_MAXMEMORY=1280mb
JAEGER_MEMORY_LIMIT=1g
PROMETHEUS_MEMORY_LIMIT=2g
OTEL_MEMORY_LIMIT=1g
GRAFANA_MEMORY_LIMIT=1g

# Prometheus retention
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=20GB
